# Copy to .env and fill in real values. Never commit .env.

# HTTP listen address for the Axum API and static frontend.
# Use 0.0.0.0:8080 behind a TLS-terminating reverse proxy in production.
APP_BIND_ADDR=127.0.0.1:8080

# Project-local SQLite database. The parent directory is created automatically.
DATABASE_PATH=data/app.db

# Bounded SQLite connection pool size (1..=16). SQLite serializes writers.
DB_MAX_CONNECTIONS=5

# Built Vite frontend served by the backend. Missing directory is tolerated.
FRONTEND_DIST=frontend/dist

# Tracing filter (tracing_subscriber EnvFilter syntax).
RUST_LOG=info,tower_http=info

# Log output format: `text` (default, human readable) or `json` (structured).
LOG_FORMAT=text

# Telegram bot token from @BotFather. Required for the bot; leave empty to run
# the HTTP API and Mini App without Telegram polling (development).
# NEVER log or commit this value.
TELOXIDE_TOKEN=

# Maximum accepted age of Telegram Mini App initData, in seconds (60..604800).
# Default: 24 hours.
INIT_DATA_MAX_AGE_SECS=86400
